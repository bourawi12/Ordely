{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ordely.ai/schemas/call-payload/v2",
  "title": "Ordely Call Payload (Tunisia Edition)",
  "description": "Strict JSON Schema defining the complete payload structure required by the Ordely voice AI call engine in Tunisia. Supports trilingual routing (French, Arabic, Tunisian Derja), TND currency with 3-decimal millimes precision, +216 phone formats, and INPDP compliance metadata.",
  "type": "object",
  "required": [
    "call_id",
    "call_config",
    "company",
    "customer",
    "order"
  ],
  "additionalProperties": false,
  "properties": {
    "call_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this call session, generated by the orchestrator."
    },
    "call_config": {
      "type": "object",
      "description": "Configuration parameters for the call engine.",
      "required": [
        "language",
        "script_version",
        "max_retries",
        "retry_interval_minutes",
        "call_window"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "enum": ["fr-TN", "ar-TN", "aeb-TN", "fr-FR"],
          "default": "aeb-TN",
          "description": "BCP-47 locale tag for TTS/STT. 'aeb-TN' (Tunisian Derja), 'ar-TN' (Arabic), 'fr-TN' (French Tunisia)."
        },
        "allow_dynamic_language_switch": {
          "type": "boolean",
          "default": true,
          "description": "Whether the customer can switch languages interactively during Phase 0 or during the call."
        },
        "script_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the call script to use (e.g., '2.0.0')."
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 2,
          "description": "Maximum number of retry attempts if the call is not answered."
        },
        "retry_interval_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440,
          "default": 30,
          "description": "Delay in minutes between retry attempts."
        },
        "call_window": {
          "type": "object",
          "description": "Allowed calling window in customer's local timezone (Africa/Tunis).",
          "required": ["start", "end", "timezone"],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "default": "08:30",
              "description": "Earliest allowed call time (HH:MM, 24h format)."
            },
            "end": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "default": "19:30",
              "description": "Latest allowed call time (HH:MM, 24h format)."
            },
            "timezone": {
              "type": "string",
              "default": "Africa/Tunis",
              "description": "IANA timezone identifier (Africa/Tunis)."
            }
          }
        },
        "record_call": {
          "type": "boolean",
          "default": true,
          "description": "Whether to record the call for quality assurance under INPDP rules."
        },
        "silence_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 15000,
          "default": 5000,
          "description": "Milliseconds of silence before triggering a no-response prompt."
        },
        "sentiment_escalation_threshold": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 0.0,
          "default": -0.6,
          "description": "Sentiment score threshold for human operator transfer."
        }
      }
    },
    "company": {
      "type": "object",
      "description": "Information about the B2B seller / fulfillment company in Tunisia.",
      "required": [
        "name",
        "support_phone_number",
        "support_email"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Company legal or trade name (e.g. 'TechDistrib Tunisie')."
        },
        "support_phone_number": {
          "type": "string",
          "pattern": "^(\\+216)?[234579]\\d{7}$",
          "description": "Tunisian customer support phone number (e.g., '+21671123456' or '71123456')."
        },
        "support_email": {
          "type": "string",
          "format": "email",
          "description": "Customer support email address."
        }
      }
    },
    "customer": {
      "type": "object",
      "description": "B2B customer details.",
      "required": [
        "customer_id",
        "phone",
        "email"
      ],
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique customer identifier from CRM."
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Customer's first name."
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Customer's last name."
        },
        "company_name": {
          "type": "string",
          "maxLength": 200,
          "description": "Customer's company name (B2B context)."
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+216[234579]\\d{7}$",
          "description": "Customer phone number in E.164 format (+216 XX XXX XXX)."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Customer's email address."
        },
        "preferred_language": {
          "type": "string",
          "enum": ["aeb-TN", "fr-TN", "ar-TN"],
          "default": "aeb-TN",
          "description": "Customer's initial preferred language."
        }
      }
    },
    "order": {
      "type": "object",
      "description": "Order data from the ERP/OMS system in Tunisian Dinars (TND).",
      "required": [
        "order_id",
        "order_date",
        "items",
        "total_price",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Order reference code (e.g., 'CMD-2026-04521')."
        },
        "order_date": {
          "type": "string",
          "format": "date",
          "description": "ISO 8601 date when order was placed (e.g., '2026-09-28')."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "description": "List of line items.",
          "items": {
            "type": "object",
            "required": [
              "item_id",
              "name",
              "quantity",
              "unit_price"
            ],
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "description": "SKU identifier."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "Product display name spoken by agent."
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "description": "Quantity ordered."
              },
              "unit_price": {
                "type": "number",
                "minimum": 0,
                "description": "Price per unit in TND with up to 3 decimal places (millimes)."
              },
              "unit_price_incl_tax": {
                "type": "number",
                "minimum": 0,
                "description": "Price per unit incl. VAT (TVA 19% or 7% in Tunisia)."
              },
              "line_total": {
                "type": "number",
                "minimum": 0,
                "description": "Line total (quantity × unit_price_incl_tax)."
              }
            }
          }
        },
        "total_price": {
          "type": "number",
          "minimum": 0,
          "description": "Grand total of order in TND (e.g., 196.400 for 196 Dinars 400 Millimes)."
        },
        "currency": {
          "type": "string",
          "enum": ["TND", "EUR", "USD"],
          "default": "TND",
          "description": "Currency code (default 'TND')."
        },
        "tax_amount": {
          "type": "number",
          "minimum": 0,
          "description": "Total TVA / tax amount in TND."
        },
        "estimated_delivery_date": {
          "type": ["string", "null"],
          "format": "date",
          "description": "ISO 8601 estimated delivery date, or null."
        },
        "shipping_method": {
          "type": "string",
          "maxLength": 100,
          "description": "Courier / Shipping company (e.g., 'Aramex Tunisia', 'Express Logistics')."
        },
        "pending_orders_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of pending orders for customer."
        }
      }
    },
    "telephony": {
      "type": "object",
      "description": "Telephony routing parameters for Tunisia telecom providers (Tunisie Telecom, Ooredoo, Orange).",
      "additionalProperties": false,
      "properties": {
        "caller_id": {
          "type": "string",
          "pattern": "^\\+216[234579]\\d{7}$",
          "description": "Outbound caller ID displayed (+216 XX XXX XXX)."
        },
        "fallback_operator_queue": {
          "type": "string",
          "minLength": 1,
          "default": "queue_support_tn_l1",
          "description": "Queue ID for human operator transfer."
        },
        "escalation_queue": {
          "type": "string",
          "minLength": 1,
          "default": "queue_support_tn_l2",
          "description": "Queue ID for priority escalation."
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata for tracing and analytics.",
      "additionalProperties": true,
      "properties": {
        "source_system": {
          "type": "string",
          "description": "Originating ERP/CRM system."
        },
        "inpdp_consent_logged": {
          "type": "boolean",
          "default": true,
          "description": "INPDP compliance logging flag."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
