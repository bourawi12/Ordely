diff --git a/mock-external-service/test/ordelyTask.test.js b/mock-external-service/test/ordelyTask.test.js
new file mode 100644
index 0000000..12522f8
--- /dev/null
+++ b/mock-external-service/test/ordelyTask.test.js
@@ -0,0 +1,154 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { GeminiLiveSession, normalizeLiveMessage } = require('../geminiLiveSession');
+const { VoiceCallAgent } = require('../voiceCallAgent');
+
+const task = {
+  taskId: 'call-7',
+  destination: '+15550001234',
+  order: {
+    id: 70,
+    customerName: 'Ines Gharbi',
+    items: [{ name: 'Montre connectée', quantity: 2, unitPrice: '120' }],
+    total: '240',
+    currency: 'TND',
+  },
+  shop: { name: 'Chez Ada', languages: ['darija'] },
+};
+
+test('with an Ordely task, Gemini gets the order and a report_decision function', async () => {
+  let params;
+  const calls = [];
+  const client = {
+    live: {
+      connect: async (p) => {
+        params = p;
+        queueMicrotask(() => p.callbacks.onmessage({ setupComplete: {} }));
+        return {
+          sendClientContent: (payload) => calls.push(['content', payload]),
+          sendToolResponse: (payload) => calls.push(['tool', payload]),
+          close() {},
+        };
+      },
+    },
+  };
+  const live = await GeminiLiveSession.connect({ client, task });
+  const instruction = params.config.systemInstruction;
+  for (const fact of ['Ines Gharbi', '2 x Montre connectée', '240 TND', 'Chez Ada', 'report_decision']) {
+    assert.ok(instruction.includes(fact), `instruction mentions ${fact}`);
+  }
+  assert.equal(params.config.tools[0].functionDeclarations[0].name, 'report_decision');
+
+  live.introduce();
+  assert.match(calls[0][1].turns[0].parts[0].text, /confirm the order/);
+  live.acknowledgeTool('fc-1', 'report_decision');
+  assert.deepEqual(calls[1], ['tool', { functionResponses: [{ id: 'fc-1', name: 'report_decision', response: { result: 'recorded' } }] }]);
+});
+
+test('without a task, nothing changes: no tools, the original instruction', async () => {
+  let params;
+  const client = {
+    live: {
+      connect: async (p) => {
+        params = p;
+        queueMicrotask(() => p.callbacks.onmessage({ setupComplete: {} }));
+        return { sendClientContent() {}, close() {} };
+      },
+    },
+  };
+  await GeminiLiveSession.connect({ client });
+  assert.equal(params.config.tools, undefined);
+  assert.doesNotMatch(params.config.systemInstruction, /report_decision/);
+});
+
+test('reads a report_decision function call as a decision event', () => {
+  const events = normalizeLiveMessage({
+    toolCall: {
+      functionCalls: [
+        { id: 'fc-1', name: 'report_decision', args: { intent: 'CONFIRMED', confidence: 0.94, language: 'TUNISIAN_ARABIC' } },
+        { id: 'fc-2', name: 'something_else', args: {} },
+      ],
+    },
+  });
+  assert.deepEqual(events, [
+    { type: 'decision', id: 'fc-1', name: 'report_decision', args: { intent: 'CONFIRMED', confidence: 0.94, language: 'TUNISIAN_ARABIC' } },
+  ]);
+});
+
+test('sends the decision to Ordely as the result, and hangs up after a clear answer', async () => {
+  const handlers = new Map();
+  const socket = {
+    connected: true,
+    on: (event, cb) => handlers.set(event, cb),
+    emit() {},
+    disconnect() { this.connected = false; },
+    io: { on() {} },
+  };
+  let listener;
+  const acknowledged = [];
+  const results = [];
+  const agent = new VoiceCallAgent({
+    serverUrl: 'http://127.0.0.1:9',
+    destinationNumber: '+15550001234',
+    ioClient: () => socket,
+    wrtc: {},
+    geminiFactory: async () => ({
+      onEvent(cb) { listener = cb; return () => {}; },
+      acknowledgeTool: (id, name) => acknowledged.push([id, name]),
+      close() {},
+    }),
+    artifactStore: { finalizeCall: async () => [] },
+    artifactClient: { appendTranscript: async () => {}, saveAudioAssets: async () => {} },
+    logger: { info() {}, warn() {}, error() {} },
+    taskId: 'call-7',
+    ordelyClient: {
+      sendEvent: async () => {},
+      sendTranscript: async () => {},
+      uploadRecording: async () => {},
+      sendResult: async (r) => results.push(r),
+    },
+    decisionHangupMs: 5,
+  });
+
+  const finished = agent.start();
+  handlers.get('connect')();
+  handlers.get('participant:registered')();
+  handlers.get('call:outgoing')({ callId: 'c-1', number: '+15550001234' });
+  for (let i = 0; i < 20 && !listener; i += 1) await new Promise(setImmediate);
+
+  listener({ type: 'decision', id: 'fc-1', name: 'report_decision', args: { intent: 'CONFIRMED', confidence: 0.94, language: 'TUNISIAN_ARABIC' } });
+  await finished;
+
+  assert.deepEqual(acknowledged, [['fc-1', 'report_decision']]);
+  assert.equal(results.length, 1);
+  assert.equal(results[0].disposition, 'completed');
+  assert.equal(results[0].intent, 'CONFIRMED');
+  assert.equal(results[0].confidence, 0.94);
+  assert.equal(results[0].language, 'TUNISIAN_ARABIC');
+});
+
+test('a call that ends without any decision is reported as completed, never confirmed', async () => {
+  const handlers = new Map();
+  const socket = { connected: true, on: (e, cb) => handlers.set(e, cb), emit() {}, disconnect() {}, io: { on() {} } };
+  const results = [];
+  const agent = new VoiceCallAgent({
+    serverUrl: 'http://127.0.0.1:9',
+    destinationNumber: '+15550001234',
+    ioClient: () => socket,
+    wrtc: {},
+    geminiFactory: async () => ({ onEvent: () => () => {}, close() {} }),
+    artifactStore: { finalizeCall: async () => [] },
+    artifactClient: { appendTranscript: async () => {}, saveAudioAssets: async () => {} },
+    logger: { info() {}, warn() {}, error() {} },
+    taskId: 'call-8',
+    ordelyClient: { sendEvent: async () => {}, sendResult: async (r) => results.push(r) },
+  });
+  const finished = agent.start();
+  handlers.get('connect')();
+  handlers.get('participant:registered')();
+  handlers.get('call:outgoing')({ callId: 'c-2', number: '+15550001234' });
+  handlers.get('call:ended')({ reason: 'completed' });
+  await finished;
+  assert.equal(results[0].disposition, 'completed');
+  assert.equal(results[0].intent, undefined);
+});
