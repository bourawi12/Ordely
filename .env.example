# Copy to .env to override docker compose defaults.
POSTGRES_USER=ordely
POSTGRES_PASSWORD=ordely
POSTGRES_DB=ordely

# Required: secret used to sign login tokens (openssl rand -hex 32)
JWT_SECRET=
# Token lifetime in seconds
JWT_EXPIRES_IN=86400

# Host ports
DB_PORT=5433
BACKEND_PORT=3001
FRONTEND_PORT=3200

# Object storage (MinIO) — user uploads
MINIO_ROOT_USER=ordely
MINIO_ROOT_PASSWORD=ordely-minio-secret
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
S3_BUCKET=ordely-media
# Address browsers use to load files (must match MINIO_PORT)
S3_PUBLIC_URL=http://localhost:9100

# Outgoing email (verification links). By default everything goes to Mailpit, a local inbox at
# http://localhost:8025 that delivers nothing. For real delivery, fill in your provider's SMTP.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Ordely <no-reply@ordely.tn>
# Address of the app in the links sent by email
APP_URL=http://localhost:3200
