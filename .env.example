# Copy to .env to override docker compose defaults.
POSTGRES_USER=ordely
POSTGRES_PASSWORD=ordely
POSTGRES_DB=ordely

# Required: secret used to sign login tokens (openssl rand -hex 32)
JWT_SECRET=
# Token lifetime in seconds
JWT_EXPIRES_IN=86400

# Host ports
DB_PORT=5433
BACKEND_PORT=3001
FRONTEND_PORT=3200

# Object storage (MinIO) — user uploads
MINIO_ROOT_USER=ordely
MINIO_ROOT_PASSWORD=ordely-minio-secret
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
S3_BUCKET=ordely-media
# Address browsers use to load files (must match MINIO_PORT)
S3_PUBLIC_URL=http://localhost:9100
