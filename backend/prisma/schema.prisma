generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Order status: "pending" (awaiting confirmation), "confirmed" or "cancelled".
model Order {
  id        Int      @id @default(autoincrement())
  customer  String   @db.VarChar
  phone     String   @default("") @db.VarChar(30)
  item      String   @db.VarChar
  quantity  Int
  /// Order value in TND (3 decimals for millimes).
  total     Decimal  @default(0) @db.Decimal(10, 3)
  status    String   @default("pending") @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  calls     Call[]

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// One confirmation call attempt for an order.
/// Status: "pending" (queued), "confirmed", "failed" or "no_answer".
model Call {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          String   @default("pending") @db.VarChar(20)
  attempt         Int      @default(1)
  durationSeconds Int?
  language        String?  @db.VarChar(30)
  /// [{ "speaker": "agent" | "customer", "text": string }]
  transcript      Json?
  recordingUrl    String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("calls")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  boutiqueId   Int
  boutique     Boutique @relation(fields: [boutiqueId], references: [id])
  /// Object key of the profile picture in the S3 bucket (never a URL: URLs are signed on read).
  avatarKey    String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([boutiqueId])
  @@map("users")
}

/// The merchant's shop. Created empty at registration and filled by the onboarding.
/// Allowed values for the list fields live in backend/src/boutique/boutique-options.ts.
model Boutique {
  id                    Int       @id @default(autoincrement())
  // Screen 1 (required) — identity
  name                  String?   @db.VarChar(100)
  businessPhone         String?   @db.VarChar(30)
  platform              String?   @db.VarChar(30)
  // Screen 2 (required) — agent
  callLanguages         String[]  @default([])
  /// "HH:MM", Africa/Tunis.
  callStartTime         String?   @db.VarChar(5)
  callEndTime           String?   @db.VarChar(5)
  confirmationProcess   String?   @db.VarChar(30)
  // Screen 3 (optional) — business details
  sector                String?   @db.VarChar(30)
  /// Gouvernorat codes, or ["all"] for the whole country.
  deliveryZones         String[]  @default([])
  dailyOrderVolume      String?   @db.VarChar(20)
  acquisitionSource     String?   @db.VarChar(30)
  carrier               String?   @db.VarChar(30)
  onboardingCompletedAt DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  users                 User[]

  @@map("boutiques")
}
