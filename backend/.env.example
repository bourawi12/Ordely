SMTP_PORT=1025
MAIL_FROM=Ordely <no-reply@ordely.tn>
APP_URL=http://localhost:3200
CALL_SERVER_URL=http://127.0.0.1:4100
CALL_SERVER_FALLBACK_URL=https://voip-ringio-prototype.vercel.app
ORDELY_CALLBACK_SECRET=dev-test-token
INTERNAL_AGENT_TOKEN=479f87dae7bfd0f2598f3e6b22a1cca83c228259cc2ce7a209b8c5eb94d14d28
GEMINI_API_KEY=AIzaSyA2ERpKcwdJnSLJz_rEkDrVHXJqbHXsfS8

# Internal back office (/admin), for the Ordely team only. At startup, the account with this
# e-mail is granted access. If it doesn't exist and ADMIN_PASSWORD is set, it is created
# (8-72 characters with upper and lower case, a number and a special character). Leave both
# empty to grant nobody. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Back office unit economics (estimates, in TND): cost of one connected minute (telephony,
# speech and LLM together) and a flat cost per call attempt (dialing, even unanswered).
COST_PER_MINUTE=0.35
COST_PER_CALL=0.02

# AI voice agent (Ringio). Off by default. When on, queued calls ("Call now") are sent to the
# agent one at a time, and the agent reports back to <backend>/api/internal/voice/*.
VOICE_DISPATCH_ENABLED=false
# Where the agent service listens (from the backend container, the PC is host.docker.internal).
VOICE_AGENT_URL=http://host.docker.internal:4200
# = AGENT_SERVICE_TOKEN in Ringio/mock-external-service/.env
VOICE_AGENT_TOKEN=
# = ORDELY_CALLBACK_SECRET in Ringio/mock-external-service/.env (16+ characters, random)
VOICE_CALLBACK_SECRET=
# Simulated number of the Ringio test phone: every call goes there, never to real customers.
VOICE_TEST_DESTINATION=+15550001234
# The agent's confidence needed to confirm or cancel an order (0-1).
VOICE_MIN_CONFIDENCE=0.8
# A dispatched call with no result after this long is closed as "no answer".
VOICE_CALL_TIMEOUT_MINUTES=10

# Plan payments (onboarding "Votre forfait"). Empty: merchants can only take the free plan.
# "simulated" = test mode with test cards, no money moves; refused when NODE_ENV=production.
# A real gateway (Konnect, Flouci) plugs in at backend/src/billing/payment-provider.ts.
PAYMENTS_PROVIDER=simulated
